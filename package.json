{
  "name": "fidelark",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc && pnpm --filter @fidelark/site typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm site:build",
    "schema:emit": "node packages/schema/scripts/emit-json-schema.ts",
    "fidelark": "node packages/cli/src/bin.ts",
    "site:dev": "pnpm --filter @fidelark/site dev",
    "site:build": "pnpm --filter @fidelark/site build",
    "site:preview": "pnpm --filter @fidelark/site preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@fidelark/analyzer": "workspace:*",
    "@fidelark/core": "workspace:*",
    "@fidelark/exporter": "workspace:*",
    "@fidelark/schema": "workspace:*",
    "@fidelark/verifier": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
