{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.3.0"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "fidelark"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "input": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "html",
            "jsx",
            "tsx",
            "markdown",
            "zip",
            "unknown"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "format",
        "sizeBytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "selfContained": {
      "type": "boolean"
    },
    "unbundled": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "script",
              "module",
              "stylesheet",
              "font",
              "image",
              "media",
              "frame",
              "network",
              "other"
            ]
          },
          "specifier": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "enum": [
              "remote",
              "relative",
              "embedded",
              "bare"
            ]
          },
          "bundled": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "specifier",
          "location",
          "bundled",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "browser": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "browser": {
              "type": "string",
              "minLength": 1
            },
            "sandboxed": {
              "type": "boolean"
            },
            "loaded": {
              "type": "boolean"
            },
            "renderedTextChars": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "blockedRequests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pageErrors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "consoleErrors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "browser",
            "sandboxed",
            "loaded",
            "renderedTextChars",
            "blockedRequests",
            "pageErrors",
            "consoleErrors"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "passed",
        "partial",
        "failed",
        "not-run"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "tool",
    "generatedAt",
    "input",
    "selfContained",
    "unbundled",
    "browser",
    "verdict",
    "findings"
  ],
  "additionalProperties": false
}
