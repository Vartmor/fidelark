{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "fidelark"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "input": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "html",
            "jsx",
            "tsx",
            "markdown",
            "zip",
            "unknown"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "format",
        "sizeBytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "script",
                      "module",
                      "stylesheet",
                      "font",
                      "image",
                      "media",
                      "fetch",
                      "other"
                    ]
                  },
                  "specifier": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bundled": {
                    "type": "boolean"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "specifier",
                  "bundled"
                ],
                "additionalProperties": false
              }
            },
            "permissions": {
              "type": "object",
              "properties": {
                "scripts": {
                  "type": "boolean"
                },
                "network": {
                  "type": "boolean"
                },
                "storage": {
                  "type": "boolean"
                }
              },
              "required": [
                "scripts",
                "network",
                "storage"
              ],
              "additionalProperties": false
            },
            "fidelity": {
              "type": "object",
              "properties": {
                "overall": {
                  "type": "string",
                  "enum": [
                    "exact-portable",
                    "bundled-portable",
                    "semantic-equivalent",
                    "connected",
                    "static-fallback",
                    "unsupported"
                  ]
                },
                "axes": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "object",
                      "properties": {
                        "class": {
                          "type": "string",
                          "enum": [
                            "exact-portable",
                            "bundled-portable",
                            "semantic-equivalent",
                            "connected",
                            "static-fallback",
                            "unsupported"
                          ]
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "class",
                        "evidence"
                      ],
                      "additionalProperties": false
                    },
                    "visual": {
                      "type": "object",
                      "properties": {
                        "class": {
                          "type": "string",
                          "enum": [
                            "exact-portable",
                            "bundled-portable",
                            "semantic-equivalent",
                            "connected",
                            "static-fallback",
                            "unsupported"
                          ]
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "class",
                        "evidence"
                      ],
                      "additionalProperties": false
                    },
                    "behavioral": {
                      "type": "object",
                      "properties": {
                        "class": {
                          "type": "string",
                          "enum": [
                            "exact-portable",
                            "bundled-portable",
                            "semantic-equivalent",
                            "connected",
                            "static-fallback",
                            "unsupported"
                          ]
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "class",
                        "evidence"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "content",
                    "visual",
                    "behavioral"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "overall",
                "axes"
              ],
              "additionalProperties": false
            },
            "exportOptions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "standalone-html",
                  "zip",
                  "markdown"
                ]
              }
            }
          },
          "required": [
            "capabilities",
            "dependencies",
            "permissions",
            "fidelity",
            "exportOptions"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "tool",
    "generatedAt",
    "input",
    "analysis",
    "findings"
  ],
  "additionalProperties": false
}
